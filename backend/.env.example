# Copy to .env and fill in values. Never commit .env.

# --- Adobe LLM (Azure OpenAI serverless / deployment URL) ---
# From Deployments + Endpoint: full URL with api-version query string, e.g.
# ADOBE_LLM_API_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT/chat/completions?api-version=2025-01-01-preview
ADOBE_LLM_API_URL=
# Same value as Azure portal "API Key" — used as Bearer token (see Azure samples)
ADOBE_LLM_API_KEY=
# Optional alias (if set, ADOBE_LLM_API_KEY can be omitted)
# AZURE_API_KEY=
# Optional: deployment name is inferred from URL .../deployments/{name}/... if unset
# ADOBE_LLM_MODEL=edna-description
# Auth: Bearer (default, matches curl samples). For api-key header only:
# ADOBE_LLM_AUTH_MODE=api-key
# Optional sampling (defaults match Azure basic sample)
# ADOBE_LLM_TOP_P=1
# ADOBE_LLM_FREQUENCY_PENALTY=0
# ADOBE_LLM_PRESENCE_PENALTY=0
# ADOBE_LLM_TIMEOUT_MS=60000

# --- Other providers (see config/aiProviders.js) ---
# PERPLEXITY_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
