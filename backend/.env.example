PORT=3001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o 
NODE_ENV=development 
MAX_ROWS_PER_REQUEST=500 
OPENAI_MODE=real 
# Set provider to 'openai' or 'perplexity' (default: perplexity) 
